---
import DefaultPageLayout from "~/layouts/default.astro";
import globalsCss from "~/styles/globals.css?raw";

const title = "Style guide";
const description =
  "The hrgui design system on one page: tokens, type, the framed grid and the components the site is built from.";

/**
 * Token values are read straight from globals.css, so this page can't drift
 * from the stylesheet. Only the grouping and the usage notes live here.
 */
function readTokens(selector: string) {
  const start = globalsCss.indexOf(`${selector} {`);
  const block = globalsCss.slice(start, globalsCss.indexOf("\n}", start));
  const tokens: Record<string, string> = {};
  for (const [, name, value] of block.matchAll(/--([a-z0-9-]+):\s*([^;]+);/g)) {
    tokens[name] = value.replace(/\s+/g, " ").trim();
  }
  return tokens;
}

const light = readTokens(":root");
const dark = readTokens(".dark");

const colorGroups = [
  {
    title: "Canvas and surface",
    note: "Grounds, from deepest to most raised.",
    tokens: [
      { name: "canvas-inset", usage: "Deepest ground: code windows, the dark frame fill." },
      { name: "canvas", usage: "Page background." },
      { name: "surface", usage: "Chips, media wells and cards sitting on canvas." },
      { name: "surface-raised", usage: "Code-window title bars, menus." },
      { name: "surface-overlay", usage: "Hover fill for rows and ghost buttons." },
    ],
  },
  {
    title: "Foreground",
    note: "Three steps of text. All pass AA on every ground.",
    tokens: [
      { name: "fg", usage: "Headlines and body copy." },
      { name: "fg-muted", usage: "Leads, descriptions, secondary text." },
      { name: "fg-subtle", usage: "Metadata, line numbers, quiet eyebrows." },
      { name: "fg-on-emphasis", usage: "Text on cta fills." },
    ],
  },
  {
    title: "Border and frame",
    note: "Hairlines carry the structure, so fills stay flat.",
    tokens: [
      { name: "grid-line", usage: "Frame rules, cell dividers, hairline rows." },
      { name: "frame-bg", usage: "Fill of frame cells and their band." },
      { name: "border-muted", usage: "Chip, code-window and media outlines." },
      { name: "border", usage: "Counters, hover outlines. Utility name: edge." },
      { name: "border-control", usage: "Secondary-button and input borders." },
    ],
  },
  {
    title: "Brand",
    note: "Cyan leads. Green and coral number the second and third of a set.",
    tokens: [
      { name: "accent", usage: "Links, mono eyebrows, the logo cursor, focus ring." },
      { name: "accent-emphasis", usage: "Accent fills and the footer divide." },
      { name: "on-accent", usage: "Text on accent-emphasis fills." },
      { name: "accent-muted", usage: "Tint behind accent text, highlighted code line." },
      { name: "success", usage: "The $ prompt, passing checks, second-column accent." },
      { name: "cta", usage: "Primary button fill. One per view." },
      { name: "cta-hover", usage: "Hover fill for cta." },
      { name: "success-muted", usage: "Tint behind added code lines." },
      { name: "coral", usage: "Third-column accent, keywords in code." },
      { name: "coral-muted", usage: "Tint behind coral text." },
    ],
  },
  {
    title: "Decoration",
    note: "Hero stage only. Never carries meaning.",
    tokens: [
      { name: "glow-accent", usage: "Hero radial glow, top left." },
      { name: "glow-success", usage: "Hero radial glow, top right." },
      { name: "grid-dot", usage: "The 8px dot grid behind stage headers." },
    ],
  },
].map((group) => ({
  ...group,
  tokens: group.tokens.map((token) => ({
    ...token,
    light: light[`color-${token.name}`],
    dark: dark[`color-${token.name}`],
  })),
}));

const typeStyles = [
  {
    name: "display-xl",
    spec: "80/84 · 800 · -0.04em",
    usage: "Home hero only.",
    className: "text-[2.75rem] font-extrabold !leading-[1.05] tracking-[-0.04em] md:text-display-xl",
    sample: "Ships pixels.",
  },
  {
    name: "display-md",
    spec: "56/60 · 800 · -0.035em",
    usage: "Page titles and section openers.",
    className: "text-headline md:text-display-md",
    sample: "Technical skills",
  },
  {
    name: "headline",
    spec: "40/46 · 700 · -0.025em",
    usage: "Featured project and group titles.",
    className: "text-title-lg md:text-headline",
    sample: "Frontend at scale",
  },
  {
    name: "title-lg",
    spec: "24/32 · 600 · -0.01em",
    usage: "Cell titles.",
    className: "text-title-lg",
    sample: "Passionate about the craft",
  },
  {
    name: "lead",
    spec: "20/30 · 400",
    usage: "Paragraph under a title, in fg-muted.",
    className: "text-lead text-fg-muted",
    sample: "I build fast, accessible interfaces and the tooling behind them.",
  },
  {
    name: "body",
    spec: "16/24 · 400",
    usage: "Default copy.",
    className: "text-base leading-relaxed text-fg-muted",
    sample: "Most of my week is TypeScript, design systems and CI pipelines.",
  },
  {
    name: "label-mono",
    spec: "JetBrains Mono · 12/16 · 500 · 0.14em · uppercase",
    usage: "Eyebrow above titles.",
    className: "label-mono text-accent",
    sample: "01 // core",
  },
  {
    name: "code",
    spec: "JetBrains Mono · 14/22 · 400",
    usage: "Prompts, code windows, chips.",
    className: "font-mono text-sm text-fg [font-variant-ligatures:none]",
    sample: "$ npx hrgui --about",
  },
];

const frameClasses = [
  { name: "hr-frame", usage: "Full-width band with a top hairline. One per section." },
  { name: "hr-frame--end", usage: "Adds the closing bottom hairline (the footer)." },
  { name: "hr-frame-col", usage: "Centred column with side rules and + registration marks." },
  { name: "hr-frame-col--bare", usage: "Same column, no rules or marks. Used inside hr-stage." },
  { name: "hr-frame-grid", usage: "1px-gap grid; the gap is the divider. Add --2, --3, --cards, --aside, --entry or --logo." },
  { name: "hr-frame-cell", usage: "A cell. --tall adds vertical room, --bleed lets media run off the edge." },
  { name: "hr-stage", usage: "Glow and dot-grid header. --screen fills the first viewport." },
];

const radii = [
  { name: "rounded-sm", value: "4px", usage: "Chips, inline code." },
  { name: "rounded-md", value: "6px", usage: "Buttons, prompt chips." },
  { name: "rounded-xl", value: "12px", usage: "Code windows, media." },
  { name: "rounded-full", value: "9999px", usage: "Counters, dots." },
];

const shadows = [
  { name: "shadow-card", usage: "Raised cards. Rare: frame cells stay flat." },
  { name: "shadow-glow", usage: "Hover on a featured element." },
  { name: "shadow-overlay", usage: "Drawer and menus." },
];

const rules = [
  {
    title: "Rules, not boxes",
    body: "Structure comes from hairlines on a flat fill. Reach for a frame cell before a rounded card.",
  },
  {
    title: "One-sided borders",
    body: "Write border-t border-t-solid, never border-t border-solid. There is no border-width reset, so the latter draws all four sides.",
  },
  {
    title: "Tokens, not hex",
    body: "Use fg, accent, grid-line and friends. They switch with the theme; hard-coded colours don't.",
  },
  {
    title: "Mono is a voice",
    body: "JetBrains Mono for eyebrows, prompts, counts and code. Plus Jakarta Sans for everything people read.",
  },
];
---

<DefaultPageLayout title={title} description={description}>
  <section class="hr-stage">
    <div class="hr-frame-col hr-frame-col--bare px-6 pb-14 pt-32 md:px-12 md:pt-36">
      <p class="label-mono text-accent">design_system // v2</p>
      <h1 class="mt-4 font-display text-[2.75rem] font-extrabold leading-[1.05] tracking-[-0.04em] text-fg md:text-display-md">
        {title}<span class="text-accent">.</span>
      </h1>
      <p class="mt-4 max-w-[60ch] text-lead text-fg-muted">{description}</p>
      <nav class="mt-8 flex flex-wrap gap-x-6 gap-y-2" aria-label="Style guide sections">
        <a class="hr-link" href="#color">Color</a>
        <a class="hr-link" href="#type">Type</a>
        <a class="hr-link" href="#frame">Frame</a>
        <a class="hr-link" href="#components">Components</a>
        <a class="hr-link" href="#rules">Rules</a>
      </nav>
    </div>
  </section>

  <!-- 01 Color -->
  <section id="color" class="hr-frame scroll-mt-16">
    <div class="hr-frame-col">
      <div class="hr-frame-grid">
        <div class="hr-frame-cell">
          <p class="label-mono mb-4 text-accent">01 // color</p>
          <h2 class="text-headline text-fg md:text-display-md">Color</h2>
          <p class="mt-4 max-w-[60ch] text-lead text-fg-muted">
            Every token has a light and a dark value. Both are shown here, read from the stylesheet at build time.
          </p>
        </div>

        {colorGroups.map((group) => (
          <div class="hr-frame-grid hr-frame-grid--aside">
            <div class="hr-frame-cell">
              <h3 class="text-title-lg text-fg">{group.title}</h3>
              <p class="mt-3 text-base leading-relaxed text-fg-muted">{group.note}</p>
            </div>
            <div class="hr-frame-cell">
              <ul class="border-t border-t-solid border-grid-line">
                {group.tokens.map((token) => (
                  <li class="grid gap-x-6 gap-y-2 border-b border-b-solid border-grid-line px-2 py-3 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
                    <div class="min-w-0">
                      <p class="font-mono text-sm text-fg">{token.name}</p>
                      <p class="mt-1 text-sm text-fg-muted">{token.usage}</p>
                    </div>
                    <dl class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs text-fg-subtle">
                      {[
                        { theme: "light", value: token.light, ground: light["color-canvas"] },
                        { theme: "dark", value: token.dark, ground: dark["color-canvas"] },
                      ].map((swatch) => (
                        <div class="flex items-center gap-2">
                          <span
                            class="block h-7 w-7 shrink-0 rounded-sm border border-solid border-border-muted p-1"
                            style={`background:${swatch.ground}`}
                            aria-hidden="true"
                          >
                            <span class="block h-full w-full rounded-[2px]" style={`background:${swatch.value}`} />
                          </span>
                          <div>
                            <dt class="uppercase tracking-[0.14em]">{swatch.theme}</dt>
                            <dd class="text-fg-muted">{swatch.value}</dd>
                          </div>
                        </div>
                      ))}
                    </dl>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 Type -->
  <section id="type" class="hr-frame scroll-mt-16">
    <div class="hr-frame-col">
      <div class="hr-frame-grid">
        <div class="hr-frame-cell">
          <p class="label-mono mb-4 text-success">02 // type</p>
          <h2 class="text-headline text-fg md:text-display-md">Type</h2>
          <p class="mt-4 max-w-[60ch] text-lead text-fg-muted">
            Plus Jakarta Sans for display and text, JetBrains Mono for the technical voice.
          </p>
        </div>

        {typeStyles.map((style) => (
          <div class="hr-frame-grid hr-frame-grid--aside">
            <div class="hr-frame-cell">
              <p class="font-mono text-sm text-fg">{style.name}</p>
              <p class="mt-2 font-mono text-xs text-fg-subtle">{style.spec}</p>
              <p class="mt-3 text-sm text-fg-muted">{style.usage}</p>
            </div>
            <div class="hr-frame-cell flex items-center overflow-hidden">
              <p class={style.className}>{style.sample}</p>
            </div>
          </div>
        ))}

        <div class="hr-frame-grid hr-frame-grid--aside">
          <div class="hr-frame-cell">
            <p class="font-mono text-sm text-fg">gradient highlight</p>
            <p class="mt-2 font-mono text-xs text-fg-subtle">from-accent to-success · bg-clip-text</p>
            <p class="mt-3 text-sm text-fg-muted">One phrase in the hero headline. Nowhere else.</p>
          </div>
          <div class="hr-frame-cell flex items-center overflow-hidden">
            <p class="text-headline text-fg md:text-display-md">
              I make
              <span class="bg-gradient-to-r from-accent to-success bg-clip-text pb-[0.12em] text-transparent">cool and awesome</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Frame -->
  <section id="frame" class="hr-frame scroll-mt-16">
    <div class="hr-frame-col">
      <div class="hr-frame-grid">
        <div class="hr-frame-cell">
          <p class="label-mono mb-4 text-coral">03 // frame</p>
          <h2 class="text-headline text-fg md:text-display-md">The framed grid</h2>
          <p class="mt-4 max-w-[60ch] text-lead text-fg-muted">
            The page is a ruled sheet. Bands span the viewport, a centred column carries the side rules, and cells are separated by a 1px gap that shows the grid-line colour through.
          </p>
        </div>

        <div class="hr-frame-grid hr-frame-grid--3">
          <div class="hr-frame-cell">
            <p class="label-mono mb-4 text-accent">01 // cell</p>
            <h3 class="mb-3 text-title-lg text-fg">hr-frame-grid--3</h3>
            <p class="text-base leading-relaxed text-fg-muted">Three equal cells from 768px, stacked below.</p>
          </div>
          <div class="hr-frame-cell">
            <p class="label-mono mb-4 text-success">02 // cell</p>
            <h3 class="mb-3 text-title-lg text-fg">Numbered eyebrows</h3>
            <p class="text-base leading-relaxed text-fg-muted">Cyan, green, coral, in that order.</p>
          </div>
          <div class="hr-frame-cell">
            <p class="label-mono mb-4 text-coral">03 // cell</p>
            <h3 class="mb-3 text-title-lg text-fg">Flat fill</h3>
            <p class="text-base leading-relaxed text-fg-muted">No radius, no shadow. The rules do the work.</p>
          </div>
        </div>

        <div class="hr-frame-grid hr-frame-grid--aside">
          <div class="hr-frame-cell">
            <h3 class="text-title-lg text-fg">Classes</h3>
            <p class="mt-3 font-mono text-xs uppercase tracking-[0.14em] text-fg-subtle">hr-frame-grid--aside</p>
          </div>
          <div class="hr-frame-cell">
            <ul class="border-t border-t-solid border-grid-line">
              {frameClasses.map((item) => (
                <li class="flex flex-col gap-x-6 gap-y-1 border-b border-b-solid border-grid-line px-2 py-3 lg:flex-row lg:items-baseline">
                  <span class="shrink-0 font-mono text-sm text-accent lg:w-[20ch]">.{item.name}</span>
                  <span class="text-sm text-fg-muted">{item.usage}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Components -->
  <section id="components" class="hr-frame scroll-mt-16">
    <div class="hr-frame-col">
      <div class="hr-frame-grid">
        <div class="hr-frame-cell">
          <p class="label-mono mb-4 text-accent">04 // components</p>
          <h2 class="text-headline text-fg md:text-display-md">Components</h2>
        </div>

        <div class="hr-frame-grid hr-frame-grid--aside">
          <div class="hr-frame-cell">
            <h3 class="text-title-lg text-fg">Buttons</h3>
            <p class="mt-3 font-mono text-xs uppercase tracking-[0.14em] text-fg-subtle">btn-*</p>
            <p class="mt-3 text-sm text-fg-muted">One primary per view. Sizes: btn-sm, default, btn-lg.</p>
          </div>
          <div class="hr-frame-cell flex flex-col gap-6">
            <div class="flex flex-wrap items-center gap-3">
              <button type="button" class="btn-primary">Primary</button>
              <button type="button" class="btn-secondary">Secondary</button>
              <button type="button" class="btn-accent">Accent</button>
              <button type="button" class="btn-ghost">Ghost</button>
              <button type="button" class="btn-secondary" disabled>Disabled</button>
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <button type="button" class="btn-secondary btn-sm">Small</button>
              <button type="button" class="btn-secondary">Default</button>
              <button type="button" class="btn-secondary btn-lg">Large</button>
            </div>
          </div>
        </div>

        <div class="hr-frame-grid hr-frame-grid--aside">
          <div class="hr-frame-cell">
            <h3 class="text-title-lg text-fg">Links and labels</h3>
            <p class="mt-3 font-mono text-xs uppercase tracking-[0.14em] text-fg-subtle">hr-link · label-mono · chips</p>
          </div>
          <div class="hr-frame-cell flex flex-col items-start gap-6">
            <a class="hr-link" href="#components">View project</a>
            <p class="label-mono text-accent">01 // module_label</p>
            <p class="inline-flex w-fit items-center gap-2 rounded-md border border-solid border-border-muted bg-surface px-3 py-1.5 font-mono text-sm text-fg-muted [font-variant-ligatures:none]">
              <span class="text-success">$</span> about
            </p>
            <p class="inline-flex w-fit items-center rounded-md border border-solid border-border-muted bg-surface px-3 py-1.5 font-mono text-sm text-success [font-variant-ligatures:none]">
              // quick_links
            </p>
            <ul class="flex flex-wrap gap-2">
              {[
                { label: "TypeScript", color: "var(--color-accent)" },
                { label: "CSS", color: "var(--color-success)" },
                { label: "Other", color: "var(--color-coral)" },
              ].map((chip) => (
                <li class="inline-flex items-center gap-1.5 rounded-sm border border-solid border-border-muted px-2 py-0.5 font-mono text-xs uppercase tracking-wider text-fg-muted">
                  <span class="h-2 w-2 shrink-0 rounded-full" style={`background-color:${chip.color}`} aria-hidden="true" />
                  {chip.label}
                </li>
              ))}
            </ul>
            <p class="hr-split"><strong>Bold claim.</strong> Muted continuation that finishes the thought.</p>
          </div>
        </div>

        <div class="hr-frame-grid hr-frame-grid--aside">
          <div class="hr-frame-cell">
            <h3 class="text-title-lg text-fg">Hairline rows</h3>
            <p class="mt-3 font-mono text-xs uppercase tracking-[0.14em] text-fg-subtle">lists, legends, skills</p>
            <p class="mt-3 text-sm text-fg-muted">Lists are rows on grid-line rules, with a mono &gt; marker and an optional count.</p>
          </div>
          <div class="hr-frame-cell">
            <ul class="border-t border-t-solid border-grid-line">
              <li class="flex gap-3 border-b border-b-solid border-grid-line px-2 py-3 text-fg-muted transition-colors duration-150 ease-out hover:bg-surface-overlay/50 hover:text-fg">
                <span class="font-mono text-accent" aria-hidden="true">&gt;</span>
                A plain row
              </li>
              <li class="border-b border-b-solid border-grid-line text-fg">
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-2 py-3 font-semibold text-fg transition-colors duration-150 ease-out marker:hidden hover:bg-surface-overlay/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent">
                    <span class="pr-2 leading-tight">A group that opens</span>
                    <span class="inline-flex items-center gap-2 text-xs text-fg-muted">
                      <span class="rounded-full px-2 py-0.5 font-mono shadow-[inset_0_0_0_1px_var(--color-border)]">2</span>
                      <span class="font-mono text-accent transition-transform duration-200 ease-out group-open:rotate-90">&gt;</span>
                    </span>
                  </summary>
                  <ul class="mb-3 ml-3 border-l border-l-solid border-grid-line pl-4">
                    <li class="flex gap-3 px-2 py-1.5 text-fg-muted">
                      <span class="font-mono text-accent" aria-hidden="true">&gt;</span>
                      Nested row
                    </li>
                    <li class="flex gap-3 px-2 py-1.5 text-fg-muted">
                      <span class="font-mono text-accent" aria-hidden="true">&gt;</span>
                      Another nested row
                    </li>
                  </ul>
                </details>
              </li>
              <li class="flex items-center justify-between gap-4 border-b border-b-solid border-grid-line px-2 py-2.5">
                <span class="flex items-center gap-2.5">
                  <span class="h-2 w-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                  <span class="font-mono text-xs uppercase tracking-[0.12em] text-fg">Legend row</span>
                </span>
                <span class="font-mono text-xs tabular-nums text-fg-muted">62%</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="hr-frame-grid hr-frame-grid--aside">
          <div class="hr-frame-cell">
            <h3 class="text-title-lg text-fg">Code window</h3>
            <p class="mt-3 font-mono text-xs uppercase tracking-[0.14em] text-fg-subtle">hr-code</p>
            <p class="mt-3 text-sm text-fg-muted">
              Lines are .ln with a data-n number. .ln--hl highlights, .ln--add marks an addition. Tokens: .k keyword, .s string, .f function, .c comment.
            </p>
          </div>
          <div class="hr-frame-cell grid gap-6 xl:grid-cols-2">
            <div class="hr-code !h-auto overflow-hidden rounded-xl border border-solid border-border-muted">
              <div class="hr-code-bar">
                <span class="hr-dot"></span><span class="hr-dot"></span><span class="hr-dot"></span>
                <span class="ml-2">about.ts</span>
              </div>
              <pre><span class="ln" data-n="1"><span class="c">// who is this</span></span><span class="ln" data-n="2"><span class="k">const</span> me = &#123;</span><span class="ln ln--hl" data-n="3">  role: <span class="s">"engineer"</span>,</span><span class="ln ln--add" data-n="4">  ships: <span class="f">pixels</span>(),</span><span class="ln" data-n="5">&#125;;</span></pre>
            </div>
            <div class="hr-code !h-auto overflow-hidden rounded-xl border border-solid border-border-muted" aria-hidden="true">
              <div class="hr-code-bar">
                <span class="hr-dot"></span><span class="hr-dot"></span><span class="hr-dot"></span>
                <span class="ml-2">~/stack</span>
              </div>
              <div class="px-4 py-4 text-sm leading-6 [font-variant-ligatures:none]">
                <p><span class="text-success">$</span> <span class="text-fg">stack --list</span></p>
                <p class="flex gap-3"><span class="text-fg-subtle">&gt;</span><span class="w-[12ch] text-accent">javascript</span><span class="text-fg-muted">12 skills</span></p>
                <p class="flex gap-3"><span class="text-fg-subtle">&gt;</span><span class="w-[12ch] text-success">html_css</span><span class="text-fg-muted">6 skills</span></p>
                <p class="flex gap-3"><span class="text-fg-subtle">&gt;</span><span class="w-[12ch] text-coral">other</span><span class="text-fg-muted">9 skills</span></p>
                <p class="text-fg-muted"><span class="text-success">✓</span> 3 groups, 27 skills</p>
                <p><span class="text-success">$</span> <span class="inline-block animate-cursor-blink text-success">▍</span></p>
              </div>
            </div>
          </div>
        </div>

        <div class="hr-frame-grid hr-frame-grid--aside">
          <div class="hr-frame-cell">
            <h3 class="text-title-lg text-fg">Logo</h3>
            <p class="mt-3 font-mono text-xs uppercase tracking-[0.14em] text-fg-subtle">wordmark + cursor</p>
            <p class="mt-3 text-sm text-fg-muted">The blinking mono bar and the "ui" take the accent.</p>
          </div>
          <div class="hr-frame-cell flex items-center">
            <div class="font-display text-[2.5rem] font-extrabold leading-none tracking-[-0.04em] text-fg">
              hrg<span class="mx-[0.02em] inline-block animate-cursor-blink font-mono font-normal text-accent">|</span><span class="text-accent">ui</span>
            </div>
          </div>
        </div>

        <div class="hr-frame-grid hr-frame-grid--2">
          <div class="hr-frame-cell">
            <h3 class="text-title-lg text-fg">Radius</h3>
            <ul class="mt-6 border-t border-t-solid border-grid-line">
              {radii.map((radius) => (
                <li class="flex items-center gap-4 border-b border-b-solid border-grid-line px-2 py-3">
                  <span
                    class="block h-10 w-10 shrink-0 border border-solid border-border-control bg-surface"
                    style={`border-radius:${radius.value}`}
                    aria-hidden="true"
                  />
                  <div class="min-w-0">
                    <p class="font-mono text-sm text-fg">{radius.name} <span class="text-fg-subtle">{radius.value}</span></p>
                    <p class="text-sm text-fg-muted">{radius.usage}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
          <div class="hr-frame-cell">
            <h3 class="text-title-lg text-fg">Shadow</h3>
            <ul class="mt-6 border-t border-t-solid border-grid-line">
              {shadows.map((shadow) => (
                <li class="flex items-center gap-4 border-b border-b-solid border-grid-line px-2 py-3">
                  <span
                    class="m-1 block h-8 w-8 shrink-0 rounded-md bg-surface"
                    style={`box-shadow:var(--${shadow.name})`}
                    aria-hidden="true"
                  />
                  <div class="min-w-0">
                    <p class="font-mono text-sm text-fg">{shadow.name}</p>
                    <p class="text-sm text-fg-muted">{shadow.usage}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Rules -->
  <section id="rules" class="hr-frame scroll-mt-16">
    <div class="hr-frame-col">
      <div class="hr-frame-grid">
        <div class="hr-frame-cell">
          <p class="label-mono mb-4 text-success">05 // rules</p>
          <h2 class="text-headline text-fg md:text-display-md">Rules of thumb</h2>
        </div>
        <div class="hr-frame-grid hr-frame-grid--2">
          {rules.map((rule, index) => (
            <div class="hr-frame-cell">
              <p class="label-mono mb-4 text-fg-subtle">{String(index + 1).padStart(2, "0")} // rule</p>
              <h3 class="mb-3 text-title-lg text-fg">{rule.title}</h3>
              <p class="text-base leading-relaxed text-fg-muted">{rule.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</DefaultPageLayout>
