---
import { getCollection } from "astro:content";
import DefaultPageLayout from "~/layouts/default.astro";
import Posts from "~/components/app/blog/Posts";
import type { PostFrontmatter } from "~/types/frontmatter";

const title = `Blog`;
const description = `Field notes from the web frontier: code, UI, tooling, and the occasional digital detour.`;

const posts = await getCollection("posts");
posts.sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date));
---

<DefaultPageLayout title={title} description={description}>
  <section class="hr-stage border-b border-b-solid border-grid-line">
    <div class="hr-frame-col px-6 pb-14 pt-32 md:px-12 md:pt-36">
      <p class="label-mono text-accent">system_directory</p>
      <h1 class="mt-4 font-display text-[2.75rem] font-extrabold leading-[1.05] tracking-[-0.04em] text-fg md:text-display-md">
        {title}<span class="text-accent">.</span>
      </h1>
      <p class="mt-4 max-w-[60ch] text-lead text-fg-muted">{description}</p>
    </div>
  </section>
  <Posts
    posts={posts.map((post) => ({ ...post.data, slug: `/posts/${post.id}` } as PostFrontmatter))}
    client:visible
  />
</DefaultPageLayout>
