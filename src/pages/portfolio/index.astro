---
import { getCollection } from "astro:content";
import DefaultPageLayout from "~/layouts/default.astro";
import { type PortfolioFrontmatter } from "~/types/frontmatter";
import PortfolioShowcase from "~/components/app/portfolio/PortfolioShowcase";

const title = `Portfolio`;
const description = `View Harman's showcase of work as a developer.`;

const items = await getCollection("portfolio");
---

<DefaultPageLayout title={title} description={description}>
  <section class="hr-stage">
    <div class="hr-frame-col hr-frame-col--bare px-6 pb-14 pt-32 md:px-12 md:pt-36">
      <p class="label-mono text-coral">NODE_ACCESS // PORTFOLIO_GRID</p>
      <h1 class="mt-4 font-display text-[2.75rem] font-extrabold leading-[1.05] tracking-[-0.04em] text-fg md:text-display-md">
        Portfolio<span class="text-coral">.</span>
      </h1>
      <p class="mt-4 max-w-[60ch] text-lead text-fg-muted">{description}</p>
    </div>
  </section>

  <PortfolioShowcase
    hasTitle={false}
    items={items.map(
      (item) => ({ ...item.data, slug: item.id } as PortfolioFrontmatter)
    )}
  />
</DefaultPageLayout>
